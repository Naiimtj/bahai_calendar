            "value" : "Bahá'í Calendar"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bahai Calendar"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل التقويم البهائي إلى تقاويمك لعرض أحداثك الشخصية بجانب التواريخ البهائية وإضافة الأحداث التي تنشئها في التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahá'í-Kalender greift auf Ihre Kalender zu, um Ihre persönlichen Termine neben den Bahá'í-Daten anzuzeigen und in der App erstellte Termine hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahá'í Calendar accesses your calendars to show your personal events next to Bahá'í dates and to add events you create in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario Bahá'í accede a tus calendarios para mostrar tus eventos personales junto a las fechas bahá'ís y añadir los eventos que creas en la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقویم بهائی به تقویم‌های شما دسترسی دارد تا رویدادهای شخصی شما را کنار تاریخ‌های بهائی نشان دهد و رویدادهایی را که در برنامه می‌سازید اضافه کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendrier Bahá'í accède à vos calendriers pour afficher vos événements personnels à côté des dates bahá'íes et ajouter les événements que vous créez dans l'application."
          }
        }
      }
    },
