    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل التقويم البهائي إلى تذكيراتك لإنشاء التذكيرات مباشرةً من التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahá'í-Kalender greift auf Ihre Erinnerungen zu, um Erinnerungen direkt aus der App zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahá'í Calendar accesses your reminders to create reminders directly from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario Bahá'í accede a tus recordatorios para crear recordatorios directamente desde la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقویم بهائی به یادآورهای شما دسترسی دارد تا یادآورها را مستقیماً از برنامه بسازد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendrier Bahá'í accède à vos rappels pour créer des rappels directement depuis l'application."
          }
        }
      }
    },
